# Create .env.local locally. Never paste a real key in chat or commit it.
GEMINI_API_KEY=
# Set true only after verifying this key's project is Free Tier with no billing.
# This is your confirmation, not an automatic check of Google's billing state.
GEMINI_FREE_TIER_CONFIRMED=false

# Leave GYMBROMATICS_GCS_BUCKET empty to keep using local filesystem storage.
GYMBROMATICS_GCS_BUCKET=
# Optional object-name prefix, useful for separating environments in one bucket.
GYMBROMATICS_GCS_PREFIX=staging
# Recommended on Cloud Run: a service account used through IAM signBlob.
GYMBROMATICS_GCS_SIGNING_SERVICE_ACCOUNT=
